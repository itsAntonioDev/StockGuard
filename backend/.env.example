# Copie para .env (ou gere com scripts/setup-database.ps1). Nunca versione o .env.

NODE_ENV=development
# Em produção, mantenha a API atrás de um proxy reverso com HTTPS.
HOST=127.0.0.1
PORT=3333

# Papel de execução (sem DDL). Veja docs/seguranca.md.
DATABASE_URL=postgresql://stockguard_app:SENHA@localhost:5432/stockguard_dev
# Papel dono do schema, usado apenas por migrações.
MIGRATION_DATABASE_URL=postgresql://stockguard_migrator:SENHA@localhost:5432/stockguard_dev

# Origem autorizada do frontend (CORS e verificação de Origin contra CSRF).
FRONTEND_ORIGIN=http://localhost:3000
# true somente quando houver proxy reverso confiável na frente da API.
TRUST_PROXY=false
# true em produção (HTTPS obrigatório).
COOKIE_SECURE=false

SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30

# Perfis obrigados a usar MFA (TOTP), separados por vírgula. Vazio desativa.
MFA_REQUIRED_ROLES=ADMIN
# 32 bytes aleatórios em base64. Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
EVIDENCE_STORAGE_DIR=storage/evidence

# Apenas para `npm run db:seed` (primeiro administrador). Remova depois.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
